#!/usr/bin/env bash
# cp-agent: control-plane node agent (PLAN WP-03).
#
#   cp-agent agent     three loops: watchdog (1 s), lease tick (10 s), everything else (30 s)
#   cp-agent full      one pass of everything (docs, markers, heartbeats, lease, holder, directives, ...)
#   cp-agent lease     one lease tick (lease step and holder reconcile only)
#   cp-agent watchdog  one watchdog check (fences a holder whose last renewal is 20 s old)
#
# Fail-static: a failing step is logged and the loop continues with the last valid state. The one
# exception is the headscale lease: a holder that cannot renew stops headscale (lease.sh).
set -uo pipefail

AGENT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENT_LIB="${AGENT_LIB:-$AGENT_HOME/lib}"
FC_SHARED_LIB="${FC_SHARED_LIB:-$AGENT_LIB/shared}"
export FC_SHARED_LIB

# shellcheck source=/dev/null
. "$FC_SHARED_LIB/common.sh"
for f in agent s3 docs lease cert headscale tailscale directives health; do
  # shellcheck source=/dev/null
  . "$AGENT_LIB/$f.sh"
done

# The lease tick (every 10 s): lease step and holder reconcile. Nothing slow runs here.
cycle_lease() {
  # right after a start the first tick may come before the first full cycle
  if ! desired_present; then
    step docs docs_sync
  fi
  step lease lease_step
  step holder holder_reconcile
}

cycle_docs() {
  step docs docs_sync
  step markers markers_sync
  step heartbeats-fetch heartbeats_fetch
  step marker-uploads marker_requests_upload
}

cycle_work() {
  step holder-extras holder_extras
  step tailscale tailscale_ensure
  step reset reset_step
  step health health_step
  step heartbeat heartbeat_put
}

# The 30 s cycle of everything but the lease tick (own loop in production).
cycle_slow() {
  cycle_docs
  cycle_work
}

# One pass of everything (tests, manual runs).
cycle_full() {
  cycle_docs
  cycle_lease
  cycle_work
}

loop_every() {
  local period=$1 fn=$2 start left
  while true; do
    start=$SECONDS
    "$fn"
    left=$((period - (SECONDS - start)))
    if [ "$left" -gt 0 ]; then
      sleep "$left"
    fi
  done
}

loop_watchdog() {
  while true; do
    watchdog_check
    sleep 1
  done
}

LOOP_PIDS=()
shutdown() {
  local pid
  trap - TERM INT
  for pid in "${LOOP_PIDS[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
  # the containers must not outlive the agent
  holder_stop
  exit 0
}

# Three independent loops: the watchdog (1 s), the lease tick (10 s) and the rest (30 s). A slow or
# stuck S3 call in one of them cannot delay the others, and the fence never waits for a renewal.
cmd_agent() {
  if [ "$DISABLE_AGENT" = true ]; then
    fc_log "DISABLE_AGENT=true: idle"
    while true; do sleep 3600; done
  fi
  fc_log "starting (node $NODE_NAME, instance $INSTANCE_UUID)"
  trap shutdown TERM INT
  loop_watchdog &
  LOOP_PIDS+=("$!")
  loop_every "$LEASE_RENEW_SECONDS" cycle_lease &
  LOOP_PIDS+=("$!")
  loop_every 30 cycle_slow &
  LOOP_PIDS+=("$!")
  wait -n
  fc_log "a loop exited: shutting down"
  shutdown
}

main() {
  local cmd=${1:-agent}
  agent_init
  case "$cmd" in
    agent) cmd_agent ;;
    full) cycle_full ;;
    lease) cycle_lease ;;
    watchdog) watchdog_check ;;
    *)
      echo "usage: cp-agent agent|full|lease|watchdog" >&2
      exit 2
      ;;
  esac
}

main "$@"
